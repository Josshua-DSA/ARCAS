# Salin ke `.env` lalu isi nilainya. JANGAN commit `.env`.
#
# Kunci di bawah dipakai oleh backend/src/collect/news_api/registry.py.
# Periksa status kunci kapan saja dengan:
#   python -m backend.src.collect.news_cli identify

# Finnhub — https://finnhub.io/register
# Gratis 60 req/menit. Berita general/forex/merger. STATUS: TERVERIFIKASI OK.
FINNHUB_API_KEY=

# Marketaux — https://www.marketaux.com/
# Gratis 100 req/hari. Pakai countries=us; filter simbol XAU kosong di free tier.
# Catatan: HTTP 500 muncul bila kuota harian habis.
MARKETAUX_API_KEY=

# Alpha Vantage — https://www.alphavantage.co/support/#api-key
# Gratis 25 req/hari, TAPI NEWS_SENTIMENT termasuk premium endpoint.
# Pada kunci gratis endpoint ini akan menjawab "premium endpoint".
ALPHAVANTAGE_API_KEY=

# Eulerpool — https://eulerpool.com/developers/register
# API resmi (Bearer token, bukan query param). Berita pasar + data komoditas/makro.
# PENTING: kuota harian kecil. Adapter membatasi 10-100 req/hari (hard cap 100).
# Satu request market-news (limit<=200) melayani XAU+RATE_UST+SPX sekaligus.
EULERPOOL_API_KEY=
