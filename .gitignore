.cache/
*.zip
*.pdf
!research/papers/*.pdf
.huggingface/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
model/*/weights/*.bin
model/*/weights/*.safetensors
model/*/weights/*.pt
model/*/weights/*.onnx
# Direktori checkpoint hasil latih (save_pretrained): 440MB, direproduksi
# lewat scripts.train_xau_finbert. Metadata kecil (metrics/temperature.json)
# tetap di-commit karena itu ringkasan hasil yang bisa diaudit.
model/*/weights/*/
outputs/
*.db
*.db-journal
# Backup DB dibuat sebelum backfill — jangan masuk repo (berisi data penuh).
data/*.db.bak-*
# State progres backfill: milik mesin yang menjalankannya, bukan artefak kode.
data/backfill_state.json
.venv/
venv/
.env

# Code graph — commit the artefacts agents read, skip rebuild cache & snapshots
.graphify/cache/
.graphify/2*/
.graphify/.graphify_analysis.json
.graphify/*.sig

# Artefak model terlatih — dilatih ulang oleh `python -m model.common.train_baseline`
# (pickling sklearn terikat versi Python/scikit-learn, jangan di-commit)
model/common/*.joblib

# Figcraft: alat bantu tangkapan layar + manifest desain, bukan bagian aplikasi.
# Hasilnya PNG/JSON besar dan bisa dibangun ulang kapan saja.
frontend/figcraft/
scripts/figcraft_*

# Catatan kerja agen (rencana, skrip ukur sekali pakai) dan bahan riset lokal.
# Bukan bagian aplikasi; isinya bergantung mesin dan sesi.
.hermes/
Research/
